# dotnet-agent-harness — the entire configuration surface.
#
# Copy to `harness.yml` at your repo root. Everything here is optional: omit a
# key and it is auto-discovered or falls back to the default shown.
#
# Thresholds live HERE and nowhere else. `install.ps1` renders them into
# CodeMetricsConfig.txt, stryker-config.json, the .editorconfig gate severities,
# and the constitution's Verification Gates article. Editing those files directly
# means the next install overwrites you — change this file instead.
#
# Format note: this is parsed by a deliberately strict YAML *subset* reader
# (2-space indent, `key: value` scalars, nested maps, `#` comments). No lists,
# anchors, or multi-line strings. Unknown keys are an error, not a silent no-op,
# so a typo fails loudly instead of quietly reverting a threshold to default.

# Which version of the harness produced this file. Written by install.ps1 and
# updated on every run - don't edit it by hand. Its job is to answer "what am I
# on?" after an install changes behaviour, and to let the installer report
# 0.7.0 -> 0.7.1 rather than overwriting silently. Kept in lockstep with the
# VERSION file by Test-HarnessConfig.ps1, so a fresh install reports the truth.
harnessVersion: 0.7.1

# Which language pack's gates to run. Only `dotnet` ships today.
pack: dotnet

# Branch that changed-file detection diffs against.
# Omit to use the remote's default branch (origin/HEAD).
baseBranch: main

# Issue tracker for `/task` intake. One of:
#   github   — GitHub Issues via the gh CLI (default, backward-compatible)
#   youtrack — YouTrack REST via YOUTRACK_URL / YOUTRACK_TOKEN (header-only auth)
#              (the token belongs in YOUTRACK_TOKEN, never in this file)
#   none     — description-only; no tracker contact
# There is no task.tracker setting and no CLI tracker override.
# Alternatives:
# tracker: youtrack
# tracker: none
tracker: github

# Path to the solution. Omit to auto-resolve: the sole candidate wins; with
# multiple candidates, the unique repo-root solution wins; otherwise set this.
solution: null

task:
  # Create each task in its own git worktree instead of switching the current
  # checkout. On by default because a single checkout serialises work: one agent
  # holding a branch blocks every other agent, and a dirty tree blocks intake
  # entirely. Separate worktrees let tasks run in parallel without any of that.
  #
  # Set to false for a one-checkout workflow. Each worktree is a full checkout
  # needing its own `dotnet restore`, which is the cost you are opting out of.
  worktree: true

  # Where worktrees are created. Omit for `<repo>.worktrees` beside the repo -
  # a sibling, deliberately NOT inside it. Git excludes linked worktrees from
  # `git status`, but nothing else does: an in-repo worktree is walked by
  # `dotnet build`, InspectCode, and every recursive glob, so one task's
  # checkout shows up in another task's gate results. A relative value is
  # resolved against the repo root. Either way, a value that lands inside the
  # repo is rejected - the script refuses rather than produce that layout.
  worktreeRoot: null

gates:
  complexity:
    # CA1502 cyclomatic complexity ceiling.
    # Two values because the bar tightens after the code works:
    # `implement` applies while building, `refactor` at the refactor gate.
    implement: 15
    refactor: 6

  mutation:
    # Stryker mutation score floor, as a percentage, on changed code.
    # A surviving mutant means the test is inadequate — fix the test, not this number.
    threshold: 80

    # Artifact-kill guard, expressed as a share of tested mutants. One test that
    # kills more than this percentage of the mutants a run tested is a suspected
    # artifact kill - usually a test that fails on every run, which inflates the
    # score without asserting anything. 1..100. The rule is not applied when a
    # run tested fewer than 20 mutants, because one test can legitimately hold
    # most of a sample that small.
    maxKillShare: 50

    # Artifact-kill guard, expressed as a file span: the most distinct source
    # files one test may kill mutants in. A unit test exercises a few related
    # types, so a wider span means the test is failing for a reason outside the
    # mutation (state leaking across mutant runs). Integer >= 1. It catches
    # contamination that stays under the share limit.
    maxKillFileSpan: 15

    # Test-runner parallelism. `null` means half the runner's logical cores,
    # which is Stryker's own ceiling and recommendation. Raise it only if you
    # have measured that it does not turn survivors into timeouts: a timeout
    # counts as detected, so over-subscription raises the score dishonestly.
    concurrency: null

    # The project `-WholeProject` mutates when the command line names none. `null`
    # auto-detects: the one production project that has an eligible test project
    # and is not excluded. Set it when a repo has more than one, because mutating
    # whichever one happens to sort first would make a failing gate unauditable.
    # The value is the project name as `-Project` takes it (no .csproj suffix).
    wholeProject: null

    # The Stryker test runner `install.ps1` renders into stryker-config.json.
    # `vstest` is Stryker's default and right for xUnit v2, NUnit and MSTest.
    # `mtp` is required by xUnit v3 test projects, whose tests are executables:
    # under VSTest they run in a child process that never sees the active mutant,
    # so every mutant survives and the gate reports a false failure. `null`
    # leaves the file's own `test-runner` untouched, which is what a repo that
    # already chose a runner on purpose wants. scripts/run-mutation.ps1 refuses
    # to run until stryker-config.json names its runner, and requires
    # `coverage-analysis: off` plus `additional-timeout` of at least 30000 ms
    # when it is `mtp`.
    runner: null

    # Projects that are never mutated, each with the reason printed alongside
    # its NOT APPLICABLE verdict. The key is the project name as `-Project`
    # takes it (no .csproj suffix), matched case-insensitively; a name here that
    # matches no changed project is inert. Use it for a project whose proof
    # needs a host, a database, or another process this gate does not drive.
    # The delete-me pair below documents the shape - remove it for your repo.
    exclusions:
      Contoso.Api: "host proof lives in integration tests this gate does not drive"

  analyzers:
    # `All` enables the full CA rule set including the security families
    # (CA2100, CA3xxx, CA5xxx) that are off by default. This is what replaces
    # a hosted static-analysis service for the pre-PR signal.
    mode: All

    # false by default, on purpose. This harness is adopt-first: turning every
    # analyzer warning into a build error on an existing codebase breaks the
    # build on day one over findings that predate the install, and the usual
    # response is to rip the harness out.
    #
    # The gates are what enforce quality here - they fail on findings in CHANGED
    # files, which is the bar that matters. Set this to true on a greenfield
    # project, or once the existing warnings are cleared.
    warningsAsErrors: false

  vulnerablePackages:
    fail: true
    includeTransitive: true

  inspectCode:
    enabled: true

  propertyTests:
    enabled: true

  web:
    # Switch for a repo-owned frontend gate script (for example
    # scripts/run-web-gates.ps1). The harness only validates the key; keep it
    # false until the repo has a web app to gate.
    enabled: false

agents:
  # Agents declare a tier (fast / balanced / deep), never a model id, so a model
  # rename is a one-line fix here rather than an edit across every agent file.
  #
  # Only fast is pinned by default, because its work is mechanically checkable.
  # Balanced and deep inherit the active host/session model. Set both fields to
  # inherit to undo a pin; inherited fields are omitted where the host supports
  # that fallback.
  tiers:
    fast:
      claude:
        model: claude-haiku-4-5-20251001
        effort: low
      cursor:
        model: gpt-5.6-luna
        effort: low
      codex:
        model: gpt-5.6-terra
        effort: low
    balanced:
      claude:
        model: inherit
        effort: inherit
      cursor:
        model: inherit
        effort: inherit
      codex:
        model: inherit
        effort: inherit
    deep:
      claude:
        model: inherit
        effort: inherit
      cursor:
        model: inherit
        effort: inherit
      codex:
        model: inherit
        effort: inherit
