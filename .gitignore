# Harness config resolved per-consumer — the example is tracked, the real one is not
/harness.yml

# .NET
bin/
obj/
[Bb]uild/
artifacts/
*.user
*.suo
.vs/

# Test + analysis output
StrykerOutput/
TestResults/
coverage/
*.trx
inspectcode-report.xml

# Spec Kit is a runtime dependency, not vendored — see NOTICE
.specify/

# Tooling
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# This repository does not project its skills into host discovery trees
# (ADR 0012). Ignore them so a stray sync or an installed plugin cannot add
# invocable copies of the canonical skills back to the checkout.
/.claude/skills/
/.agents/

# Route-map advisor log: personal usage evidence, not the authored artifact.
# route-map.json itself IS tracked (it's the durable output of #46).
/scripts/local/route-log.jsonl

# Host agent-discovery trees generated by opening this repo in another tool
# (Junie, Cursor, Codex) to trust it or copy profiles across. They are that
# tool's local projection, not harness sources, and they go stale the moment a
# canonical profile changes — so they must never be committed.
#
# NOT /.claude/agents/: that one IS the canonical, tracked source every other
# host's copy is generated FROM. Ignoring it would delete the originals from
# version control.
/.junie/
/.cursor/agents/
/.codex/agents/
